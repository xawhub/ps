function queryData(Inputs, Outputs) 
{
    var searchString = Inputs.GetProperty("search-string") || Inputs.GetProperty("Search Specification");
    var contactIds = [];
    
    // 1. Wyciągamy WSZYSTKIE unikalne "Contact Id" ze skomplikowanego Search Speca
    if (searchString) {
        var regexContact = /\[Contact Id\]\s*(?:=|LIKE)\s*['"]([^'"]+)['"]/gi;
        var match;
        
        while ((match = regexContact.exec(searchString)) !== null) {
            var id = match[1];
            if (contactIds.indexOf(id) === -1) {
                contactIds.push(id);
            }
        }
    }

    // Jeśli brak ID w zapytaniu (np. błąd UI), kończymy - VBC pokaże pusty aplet
    if (contactIds.length === 0) {
        return; 
    }

    // Przygotowujemy obiekty Siebela (raz przed pętlą, by nie obciążać pamięci)
    var boContact = app.GetBusObject("Contact");
    var bcContact = boContact.GetBusComp("Contact");
    var wfSvc = app.GetService("Workflow Process Manager");
    
    try 
    {
        // 2. Pętla dla każdego znalezionego Kontaktu w zapytaniu
        for (var k = 0; k < contactIds.length; k++) 
        {
            var currentContactId = contactIds[k];
            var profileId = "";
            var accountIntegrationId = "";

            // A) Pobieramy wartości bezpośrednio z DB bez blokowania UI
            bcContact.SetViewMode(AllView);
            bcContact.ClearToQuery();
            bcContact.SetSearchSpec("Id", currentContactId);
            bcContact.ExecuteQuery(ForwardOnly);

            if (bcContact.FirstRecord()) {
                profileId = bcContact.GetFieldValue("TMO Profile Id");
                accountIntegrationId = bcContact.GetFieldValue("Account Integration Id"); // Dostosuj ew. nazwę
            }

            // B) Wywołanie API tylko jeśli Kontakt ma Profile Id
            if (profileId !== "") 
            {
                var query = buildQuery(Inputs); 
                
                var psIn = app.NewPropertySet();
                var psOut = app.NewPropertySet();

                psIn.SetProperty("ProcessName", "TMO permissions MAPI");
                psIn.SetProperty("Input_TMOSSOId", profileId);
                psIn.SetProperty("Input_AccountIntegrationId", accountIntegrationId);
                psIn.SetProperty("Input_Query", query);
                psIn.SetProperty("Input_Fields", "assetRoles.role.id");
                
                wfSvc.InvokeMethod("RunProcess", psIn, psOut);

                // C) Bezpieczne parsowanie odpowiedzi (unikamy Null Pointer)
                if (psOut.GetChildCount() > 0) {
                    var respResponsePS = psOut.GetChild(0);
                    if (respResponsePS && respResponsePS.GetChildCount() > 0) {
                        var listResponsePS = respResponsePS.GetChild(0);
                        if (listResponsePS && listResponsePS.GetChildCount() > 0) {
                            var resp200PS = listResponsePS.GetChild(0);
                            if (resp200PS && resp200PS.GetChildCount() > 0) {
                                var listRespBodyPS = resp200PS.GetChild(0);
                                
                                if (listRespBodyPS && listRespBodyPS.GetType() === "ListOfRespBody") {
                                    
                                    for (var i = 0; i < listRespBodyPS.GetChildCount(); i++) {
                                        var respBodyPS = listRespBodyPS.GetChild(i);
                                        
                                        if (respBodyPS.GetChildCount() > 0) {
                                            var listAssetRolesPS = respBodyPS.GetChild(0);
                                            
                                            if (listAssetRolesPS && listAssetRolesPS.GetChildCount() > 0) {
                                                var assetRolesPS = listAssetRolesPS.GetChild(0);
                                                
                                                if (assetRolesPS && assetRolesPS.GetChildCount() > 0) {
                                                    var listRolePS = assetRolesPS.GetChild(0);
                                                    
                                                    if (listRolePS && listRolePS.GetChildCount() > 0) {
                                                        var rolePS = listRolePS.GetChild(0);
                                                        var roleId = rolePS.GetProperty("id");
                                                        
                                                        // D) Budowanie wiersza dla VBC
                                                        var row = app.NewPropertySet();
                                                        row.SetProperty("Integration Id", respBodyPS.GetProperty("id"));
                                                        row.SetProperty("Role", getRoleValue("TMO HAL LIC", roleId, "Value"));
                                                        row.SetProperty("Description", getRoleValue("TMO HAL LIC", roleId, "Desc"));
                                                        
                                                        // KLUCZOWE: Ustawiamy z powrotem ID kontaktu. 
                                                        // Dzięki temu Siebel w ułamku sekundy sam nałoży na te wyniki 
                                                        // filtry użytkownika z UI (np. LIKE '*OnePortal*') i nawiasy.
                                                        row.SetProperty("Contact Id", currentContactId);
                                                        
                                                        Outputs.AddChild(row);
                                                    }
                                                }
                                            }
                                        }
                                    } // end for loop (roles)
                                }
                            }
                        }
                    }
                } // end bezpiecznego parsowania
                
                // Czyścimy property sety WF po każdym strzale w pętli
                psIn = null;
                psOut = null;
            }
        } // end for loop (contactIds)
    } 
    finally 
    {
        // Finalne sprzątanie obiektów dla pamięci serwera
        if (bcContact != null) bcContact = null;
        if (boContact != null) boContact = null;
        if (wfSvc != null) wfSvc = null;
    }
}
