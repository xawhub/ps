function deleteData(Inputs, Outputs)
{
    var wfSvc = null;
    var psIn = null;
    var psOut = null;
    
    var isUIContext = false;
    var activeBO = null;
    var boContactStandalone = null;
    var bcContact = null;

    var currentContactId = "";
    var integrationId = "";
    
    var onePortalProfileId = "";
    var onePortalMultiCompany = "";
    var date = null;
    var endDateTime = "";

    try 
    {
        fnLog("=============================================");
        fnLog("| deleteData - START                        |");
        fnLog("=============================================");
        fnLog("Inputs: \n" + app.TMODumpPropSet(Inputs));

        wfSvc = app.GetService("Workflow Process Manager");

        // ==============================================
        // 1. POBRANIE DANYCH Z INPUTS (Bez ProfileAttr!)
        // ==============================================
        var rowData = Inputs.GetChild(0);
        if (rowData) {
            integrationId = rowData.GetProperty("Integration Id");
            currentContactId = rowData.GetProperty("Contact Id");
        }

        if (!currentContactId || currentContactId === "") {
            app.RaiseErrorText("Brak identyfikatora osoby kontaktowej podczas usuwania rekordu!");
        }

        // ==============================================
        // 2. USTALENIE KONTEKSTU (UI vs Tło)
        // ==============================================
        activeBO = app.ActiveBusObject();

        if (activeBO !== null && activeBO.Name() === "Account") {
            bcContact = activeBO.GetBusComp("Contact");
            isUIContext = true;
            fnLog("| UI Context - Znaleziono BO Account");
        }

        if (!isUIContext) {
            boContactStandalone = app.GetBusObject("Contact");
            bcContact = boContactStandalone.GetBusComp("Contact");
            
            bcContact.SetViewMode(AllView);
            bcContact.ClearToQuery();
            bcContact.ActivateField("TMO Profile Id");
            bcContact.ActivateField("Account Integration Id");
            bcContact.SetSearchSpec("Id", currentContactId);
            bcContact.ExecuteQuery(ForwardOnly);

            if (!bcContact.FirstRecord()) {
                app.RaiseErrorText("Nie znaleziono osoby kontaktowej w bazie!");
            }
            fnLog("| Not UI Context (Użyto Standalone BO)");
        }

        // Pobranie atrybutów profilu bezpośrednio z Contact BC
        onePortalProfileId = bcContact.GetFieldValue("TMO Profile Id");
        onePortalMultiCompany = bcContact.GetFieldValue("Account Integration Id");

        fnLog("Contact Id: " + currentContactId);
        fnLog("Profile Id: " + onePortalProfileId);
        fnLog("MultiCompany: " + onePortalMultiCompany);
        fnLog("Integration Id (Role): " + integrationId);

        // ==============================================
        // 3. PATCH - DEZAKTYWACJA ROLI (DELETE)
        // ==============================================
        date = Date.fromSystem(Clib.time());
        endDateTime = Clib.rsprintf("%04d-%02d-%02dT%02d:%02d:%02d.000Z",
            date.getFullYear(), date.getMonth() + 1, date.getDate(),
            date.getHours(), date.getMinutes(), date.getSeconds()
        );

        fnLog("Calling PATCH /permissions - deactivate value");
        var requestPS = app.NewPropertySet();
        requestPS.SetType("Request");
        
        var validForPS = app.NewPropertySet();
        validForPS.SetType("validFor");
        
        var endDateTimePS = app.NewPropertySet();
        endDateTimePS.SetType("endDateTime");
        endDateTimePS.SetValue(endDateTime);
        
        validForPS.AddChild(endDateTimePS);
        requestPS.AddChild(validForPS);
        requestPS.SetProperty("status", "inactive");

        psIn = app.NewPropertySet();
        psOut = app.NewPropertySet();
        psIn.SetProperty("ProcessName", "TMO permissionsUpdate MAPI");
        psIn.SetProperty("Input_Id", integrationId);
        psIn.AddChild(requestPS);

        wfSvc.InvokeMethod("RunProcess", psIn, psOut);
        fnLog("PATCH Permissions Output: \n" + app.TMODumpPropSet(psOut));

        // ==============================================
        // 4. GET - SPRAWDZENIE CZY ZOSTAŁY INNE ROLE
        // ==============================================
        fnLog("Calling GET - check if deleted role was last");
        psIn.Reset();
        psOut.Reset();
        
        psIn.SetProperty("ProcessName", "TMO permissions MAPI");
        psIn.SetProperty("Input_TMOSSOID", onePortalProfileId);
        psIn.SetProperty("Input_AccountIntegrationId", onePortalMultiCompany);
        psIn.SetProperty("Input_Fields", "assetRoles.role.id");
        
        wfSvc.InvokeMethod("RunProcess", psIn, psOut);

        var respBody = null;
        if (psOut.GetChildCount() > 0 && psOut.GetChild(0).GetChildCount() > 0) {
            var restResponse = psOut.GetChild(0).GetChild(0);
            if (restResponse.GetChildCount() > 0) {
                respBody = restResponse.GetChild(0);
            }
        }

        // ==============================================
        // 5. DELETE I UPDATE KONTAKTU (Jeśli brak ról)
        // ==============================================
        if (respBody === null || respBody.GetType() !== "ListOfRespBody" || respBody.GetChildCount() === 0) 
        {
            fnLog("No roles found for profile. Removing adminCompany from profile...");
            
            psIn.Reset();
            psOut.Reset();
            
            psIn.SetProperty("ProcessName", "TMO profileManagementDelete MAPI");
            psIn.SetProperty("Input_Contact_SSO_Id", onePortalProfileId);
            psIn.SetProperty("Input_Contat_Integration_Id", onePortalMultiCompany);
            
            wfSvc.InvokeMethod("RunProcess", psIn, psOut);
            fnLog("DELETE Profile Output: \n" + app.TMODumpPropSet(psOut));

            // Czyszczenie pola na nadrzędnym BC Contact (bezpieczne dzięki detekcji UI)
            bcContact.SetFieldValue("TMO Multiparty Company", "");
            bcContact.WriteRecord();
            
            fnLog("adminCompany removed from OnePortal profile and Contact BC updated.");
        } 
        else 
        {
            fnLog("Roles still exist for profile. adminCompany will not be removed.");
        }

        Outputs.SetProperty("Status", "Success");
    }
    catch (e) 
    {
        fnLog("ERROR in deleteData: " + e.toString());
        throw e;
    }
    finally 
    {
        if (!isUIContext && boContactStandalone) {
            boContactStandalone = null;
        }
        bcContact = null;
        activeBO = null;
        psIn = null;
        psOut = null;
        wfSvc = null;
        fnLog("=============================================");
        fnLog("| deleteData - STOP                         |");
        fnLog("=============================================");
    }
}
