function updateData(Inputs, Outputs)
{
    var wfSvc = null;
    var psIn = null;
    var psOut = null;

    var onePortalProfileId = "";
    var onePortalAccIntegrationId = "";
    var currentContactId = "";

    var oldIntegrationId = "";
    var newRole = "";
    var newRoleId = "";

    // Obiekt contact do pobrania profilu w locie
    var boContact = null;
    var bcContact = null;

    var child = null;
    var i = 0;

    // get
    var respResponsePS = null;
    var listResponsePS = null;
    var resp200PS = null;
    var listRespBodyPS = null;

    // patch & post
    var requestPS = null;
    var validForPS = null;
    var endDateTimePS = null;
    var date = null;
    var endDateTime = "";

    try
    {
        wfSvc = app.GetService("Workflow Process Manager");

        // ==============================================
        // 1. DYNAMICZNE POBRANIE CONTEXTU Z INPUTS
        // ==============================================
        for (i = 0; i < Inputs.GetChildCount(); i++)
        {
            child = Inputs.GetChild(i);
            var fieldName = child.GetProperty("Field Name");
            
            if (fieldName === "Role")
            {
                newRole = child.GetProperty("Field Value");
            }
            else if (fieldName === "Integration Id")
            {
                oldIntegrationId = child.GetProperty("Field Value");
            }
            else if (fieldName === "Contact Id")
            {
                currentContactId = child.GetProperty("Field Value");
            }
        }

        // Jeśli brakuje Contact Id w polach, spróbujmy pobrać z właściwości głównej Inputs
        if (!currentContactId) {
            currentContactId = Inputs.GetProperty("Contact Id");
        }

        fnLog("updateData - currentContactId = " + currentContactId);
        fnLog("updateData - oldIntegrationId = " + oldIntegrationId);
        fnLog("updateData - newRole = " + newRole);

        if (!currentContactId) {
            TheApplication().RaiseErrorText("Brak kontekstu Contact Id w metodzie Update.");
            return;
        }

        // ==============================================
        // 2. POBRANIE DANYCH PROFILU Z BAZY DLA KONTAKTU
        // ==============================================
        boContact = app.GetBusObject("Contact");
        bcContact = boContact.GetBusComp("Contact");
        
        bcContact.SetViewMode(AllView);
        bcContact.ClearQuery();
        bcContact.SetSearchSpec("Id", currentContactId);
        bcContact.ExecuteQuery(ForwardOnly);

        if (bcContact.FirstRecord())
        {
            onePortalProfileId = bcContact.GetFieldValue("TMO Profile Id");
            onePortalAccIntegrationId = bcContact.GetFieldValue("Account Integration Id");
        }

        fnLog("onePortalProfileId = " + onePortalProfileId);
        fnLog("onePortalAccIntegrationId = " + onePortalAccIntegrationId);

        if (!onePortalProfileId || !onePortalAccIntegrationId)
        {
            TheApplication().RaiseErrorText("Nie znaleziono danych profilu OnePortal dla tego kontaktu.");
            return;
        }

        // Dekodowanie nowej roli na ID techniczne (LIC)
        newRoleId = getRoleValue("Value", newRole, "TMO HAL LIC");
        fnLog("newRoleId = " + newRoleId);

        // ==============================================
        // 3. GET - SPRAWDZENIE CZY ROLA JUŻ ISTNIEJE
        // ==============================================
        psIn = app.NewPropertySet();
        psOut = app.NewPropertySet();
        
        psIn.SetProperty("ProcessName", "TMO permissions MAPI");
        psIn.SetProperty("Input_TMOSSOId", onePortalProfileId);
        psIn.SetProperty("Input_AccountIntegrationId", onePortalAccIntegrationId);
        psIn.SetProperty("Input_Query", "contains(assetRoles,and(eq(manageableAsset.entityType,CustomerAccount),eq(role.id," + newRoleId + ")))");
        psIn.SetProperty("Input_Fields", "assetRoles.role.id");
        wfSvc.InvokeMethod("RunProcess", psIn, psOut);

        respResponsePS = psOut.GetChild(0);        
        listResponsePS = respResponsePS.GetChild(0); 
        resp200PS = listResponsePS.GetChild(0);      
        listRespBodyPS = resp200PS.GetChild(0);      

        if (listRespBodyPS && listRespBodyPS.GetType() === "ListOfRespBody")
        {
            if (listRespBodyPS.GetChildCount() > 0)
            {
                TheApplication().RaiseErrorText(TheApplication().LookupMessage("User Defined Errors", "TMO_CONTACT_DIGITAL_PROFILE_ROLE_ERR"));
                return;
            }
        }

        // ==============================================
        // 4. PATCH - DEZAKTYWACJA STAREJ ROLI
        // ==============================================
        fnLog("Calling PATCH Workflow for oldIntegrationId = " + oldIntegrationId);

        date = Date.fromSystem(Clib.time());
        endDateTime = Clib.rsprintf("%04d-%02d-%02dT%02d:%02d:%02d.000Z",
            date.getFullYear(),
            date.getMonth() + 1,
            date.getDate(),
            date.getHours(),
            date.getMinutes(),
            date.getSeconds()
        );

        psIn.Reset();
        psOut.Reset();

        requestPS = app.NewPropertySet();
        requestPS.SetType("Request");

        validForPS = app.NewPropertySet();
        validForPS.SetType("validFor");

        endDateTimePS = app.NewPropertySet();
        endDateTimePS.SetType("endDateTime");
        endDateTimePS.SetValue(endDateTime);

        validForPS.AddChild(endDateTimePS);
        requestPS.AddChild(validForPS);
        requestPS.SetProperty("status", "inactive");

        psIn.SetProperty("ProcessName", "TMO permissionsUpdate MAPI");
        psIn.SetProperty("Input_Id", oldIntegrationId);
        psIn.AddChild(requestPS);

        wfSvc.InvokeMethod("RunProcess", psIn, psOut);
        fnLog("Workflow PATCH finished");

        // ==============================================
        // 5. POST - UTWORZENIE NOWEJ ROLI
        // ==============================================
        fnLog("Calling POST Workflow");

        psIn.Reset();
        psOut.Reset();
        
        psIn.SetProperty("ProcessName", "TMO permissionsCreate MAPI");
        psIn.SetProperty("Input_TMOSSOId", onePortalProfileId);
        psIn.SetProperty("Input_AccountIntegrationId", onePortalAccIntegrationId);
        psIn.SetProperty("Input_Affiliation_Detail_Int_Id", newRoleId);
        psIn.SetProperty("Input_EnityType", "OnePortalPermission");
        
        wfSvc.InvokeMethod("RunProcess", psIn, psOut);
        fnLog("Workflow POST finished");

        Outputs.SetProperty("Status", "Success");
    }
    catch (e) 
    {
        fnLog("ERROR in updateData: " + e.toString());
        throw e;
    }
    finally
    {
        // Czyszczenie obiektów biznesowych z pamięci
        if (bcContact) { bcContact = null; }
        if (boContact) { boContact = null; }

        endDateTimePS = null;
        validForPS = null;
        requestPS = null;

        listRespBodyPS = null;
        resp200PS = null;
        listResponsePS = null;
        respResponsePS = null;

        psOut = null;
        psIn = null;
        wfSvc = null;
    }
}
