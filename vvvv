function syncProfileOnDemand(app, wfSvc, bcContact, ssoLogin, accountIntegrationId, currentProfileId) {
    // Obiekt wynikowy, który zwrócimy do głównej funkcji insertData
    var result = {
        profileId: currentProfileId,
        multipartyCompany: ""
    };

    if (!ssoLogin || ssoLogin === "") {
        app.Trace("Brak SSO Login - przerywam synchronizację profilu.");
        return result; 
    }

    var psIn = app.NewPropertySet();
    var psOut = app.NewPropertySet();
    var respBody = null;

    try {
        // ====================================================================
        // KROK 1: GET Profile (Diagram: [011] GET /profile?query=...)
        // ====================================================================
        if (!currentProfileId || currentProfileId === "") {
            
            psIn.SetProperty("ProcessName", "TMO profileManagement MAPI");
            psIn.SetProperty("Input_fields", "id,status,username,loginMethod,relatedParties");
            psIn.SetProperty("Input_query", "eq(contactMediums.medium.emailAddress," + ssoLogin + ")");
            
            wfSvc.InvokeMethod("RunProcess", psIn, psOut);

            // Bezpieczne parsowanie odpowiedzi (unikamy Null Pointer)
            if (psOut.GetChildCount() > 0 && psOut.GetChild(0).GetChildCount() > 0) {
                var c1 = psOut.GetChild(0).GetChild(0);
                if (c1.GetChildCount() > 0) {
                    var c2 = c1.GetChild(0);
                    if (c2.GetChildCount() > 0) {
                        var c3 = c2.GetChild(0);
                        if (c3.GetChildCount() > 0) {
                            respBody = c3.GetChild(0);
                        }
                    }
                }
            }

            // ====================================================================
            // KROK 2: Analiza odpowiedzi z GET
            // ====================================================================
            if (respBody != null && respBody.GetType() === "RespBody") {
                // PROFIL ZNALEZIONY
                result.profileId = respBody.GetProperty("id");
                var relatedParties = respBody.GetChildCount() > 0 ? respBody.GetChild(0) : null;
                var isAdminCompanyFound = false;
                
                // Sprawdzamy powiązania z firmą (Diagram: check if profile contains adminCompany)
                if (relatedParties != null) {
                    for (var i = 0; i < relatedParties.GetChildCount(); i++) {
                        var child = relatedParties.GetChild(i);
                        if (child.GetProperty("entityReferredType") === "Customer" &&
                            child.GetProperty("role") === "adminCompany" &&
                            child.GetProperty("id") === accountIntegrationId) {
                            
                            isAdminCompanyFound = true;
                            break;
                        }
                    }
                }

                // ====================================================================
                // KROK 3: Brak powiązania z firmą - dodajemy je (Diagram: [031] POST relatedParties)
                // ====================================================================
                if (!isAdminCompanyFound) {
                    psIn.Reset(); 
                    psOut.Reset();
                    
                    psIn.SetProperty("ProcessName", "TMO profileManagementAddRelParties MAPI");
                    psIn.SetProperty("Account Integration Id", accountIntegrationId);
                    psIn.SetProperty("Entity Referred Type", "Customer");
                    psIn.SetProperty("Role", "adminCompany");
                    psIn.SetProperty("Profile Id", result.profileId);
                    psIn.SetProperty("Input Integration Object", "Req6ProfileManagementAPI:body");
                    
                    wfSvc.InvokeMethod("RunProcess", psIn, psOut);
                    
                    if (psOut.GetProperty("Error Code") !== "") {
                        app.RaiseErrorText("Błąd podczas dodawania powiązania firmy (relatedParties) do istniejącego profilu.");
                    }
                }
                
                // Ustawiamy multipartyCompany na wartość z pomyślnego procesu
                result.multipartyCompany = accountIntegrationId;

            } 
            else {
                // ====================================================================
                // KROK 4: PROFIL NIE ZNALEZIONY - Tworzenie od zera (Diagram: [061] POST /profile)
                // ====================================================================
                psIn.Reset(); 
                psOut.Reset();
                
                // 4a. Konwersja metody logowania z użyciem TMO REST Utilities
                var bsTRU = app.GetService("TMO REST Utilities");
                var psTRUIn = app.NewPropertySet();
                var psTRUOut = app.NewPropertySet();
                
                psTRUIn.SetProperty("LOV Type", "TMO_LOGIN_METHOD");
                psTRUIn.SetProperty("Siebel LIC", bcContact.GetFieldValue("TMO Login Method"));
                bsTRU.InvokeMethod("ConvertLICLangToHAL", psTRUIn, psTRUOut);
                
                var convertedLoginMethod = psTRUOut.GetProperty("HAL LIC");
                var contactIntegrationId = bcContact.GetFieldValue("TMO Contact Id For OnePortal");

                // 4b. Tworzenie profilu
                psIn.SetProperty("ProcessName", "TMO profileManagementCreate MAPI");
                psIn.SetProperty("Input_ACCOUNT_INT_ID", accountIntegrationId);
                psIn.SetProperty("Input_CONTACT_INT_ID", contactIntegrationId);
                psIn.SetProperty("Input_CONTACT_LOGIN_SSO", ssoLogin);
                psIn.SetProperty("Input_CONTACT_OTP_MSISDN", bcContact.GetFieldValue("TMO OTP MSISDN"));
                psIn.SetProperty("Input_CONTACT_NAME", bcContact.GetFieldValue("First Name"));
                psIn.SetProperty("Input_CONTACT_LASTNAME", bcContact.GetFieldValue("Last Name"));
                psIn.SetProperty("Input_CONTACT_LOGINMETHOD", convertedLoginMethod);
                
                wfSvc.InvokeMethod("RunProcess", psIn, psOut);

                // 4c. Bezpieczne parsowanie odpowiedzi z tworzenia profilu
                respBody = null;
                if (psOut.GetChildCount() > 0 && psOut.GetChild(0).GetChildCount() > 0) {
                    var pc1 = psOut.GetChild(0).GetChild(0);
                    if (pc1.GetChildCount() > 0) {
                        respBody = pc1.GetChild(0);
                    }
                }

                if (respBody != null && respBody.GetType() === "RespBody") {
                    result.profileId = respBody.GetProperty("id");
                    result.multipartyCompany = accountIntegrationId;
                } else {
                    app.RaiseErrorText("Błąd zewnętrznego API podczas tworzenia Profilu Cyfrowego.");
                }
            }
        }

        // ====================================================================
        // KROK 5: Zapis zaktualizowanych danych na rekordzie Contact
        // ====================================================================
        if (result.profileId !== "") {
            // Zapisujemy bezpośrednio na przekazanej instancji BC - bezpieczne dla pamięci UI
            bcContact.SetFieldValue("TMO Profile Id", result.profileId);
            bcContact.SetFieldValue("TMO Multiparty Company", result.multipartyCompany);
            bcContact.WriteRecord();
            
            // Opcjonalnie: Jeśli inne skrypty w Twojej architekturze wciąż wymagają starych atrybutów, 
            // możesz je tutaj zostawić, choć architektonicznie staramy się od nich odchodzić.
            app.SetProfileAttr("TMO Profile Id For OnePortal", result.profileId);
            app.SetProfileAttr("TMO Multiparty Company For OnePortal", result.multipartyCompany);
        }

    } catch (e) {
        throw e;
    } finally {
        if (psOut != null) psOut = null;
        if (psIn != null) psIn = null;
    }

    // Zwracamy zaktualizowane ID do insertData
    return result;
}
