function OnePortalAccessSync(ctx, bcContact) {
    // Inicjujemy obiekt zwrotny (zgodnie ze standardem, jakiego oczekiwały Twoje skrypty)
    var result = {
        profileId: "",
        multipartyCompany: ""
    };

    var psRestBody = null;
    var psRelatedParties = null;
    var sProfileId = "";
    var sAccountContactIntegrationIdFromProfile = "";

    try {
        fnLog("--------------------------------------------------");
        fnLog("| SYNC ONE PORTAL PROFILE - START                |");
        fnLog("--------------------------------------------------");

        if (!bcContact) {
            throw new Error("Funkcja SyncOnePortalProfile wymaga przekazania aktywnego bcContact!");
        }

        // Zbieramy dane z Kontaktu do lokalnych zmiennych
        var accountIntId = bcContact.GetFieldValue("Account Integration Id");
        var ssoLogin     = bcContact.GetFieldValue("TMO SSO Login");
        var contactId    = bcContact.GetFieldValue("Id");
        var otpMsisdn    = bcContact.GetFieldValue("TMO OTP MSISDN");
        var firstName    = bcContact.GetFieldValue("First Name");
        var lastName     = bcContact.GetFieldValue("Last Name");
        var loginMethod  = bcContact.GetFieldValue("TMO Login Method");

        fnLog("accountIntId : " + accountIntId);
        fnLog("ssoLogin : " + ssoLogin);
        fnLog("contactId : " + contactId);
        fnLog("otpMsisdn : " + otpMsisdn);
        fnLog("firstName : " + firstName);
        fnLog("lastName : " + lastName);
        fnLog("loginMethod : " + loginMethod);

        // 1. GET PROFILE - Sprawdzamy czy profil istnieje
        ctx.ps.psWpmSyncIn = ctx.app.NewPropertySet();
        ctx.ps.psWpmSyncOut = ctx.app.NewPropertySet();

        propertySetter(ctx.ps.psWpmSyncIn, [
            { name: "Input_Fields", value: "id,status,username,loginMethod,relatedParties" },
            { name: "Input_Query", value: "eq(contactMediums.medium.emailAddress,'" + ssoLogin + "')" },
            { name: "ProcessName", value: "TMO profileManagement MAPI" }
        ]);

        fnLog("| GET PROFILE...");
        ctx.bs.workflowProcessManager.InvokeMethod("RunProcess", ctx.ps.psWpmSyncIn, ctx.ps.psWpmSyncOut);

        // Pobieramy RespBody korzystając z długiej ścieżki potwierdzonej w logach (GET)
        psRestBody = getDeepChild(ctx.ps.psWpmSyncOut, ["RestResponse", "ListOfRes15ProfileManagementAPI:res", "Resp200", "ListOfRespBody", "RespBody"]);

        // --- SCENARIUSZ A: PROFIL ISTNIEJE ---
        if (psRestBody !== null) {
            fnLog("| Profile found! Przechodze do weryfikacji powiazan (PATCH)...");
            
            sProfileId = psRestBody.GetProperty("id");
            psRelatedParties = psRestBody.GetChild(0); // ListOfrelatedParties
            
            if (psRelatedParties) {
                for (var j = 0; j < psRelatedParties.GetChildCount(); j++) {
                    var party = psRelatedParties.GetChild(j);
                    if (party.GetProperty("entityReferredType") === "Customer" && party.GetProperty("role") === "adminCompany") {
                        sAccountContactIntegrationIdFromProfile = party.GetProperty("id");
                    }
                }
            }

            if (sAccountContactIntegrationIdFromProfile === accountIntId) {
                // 100% poprawności - wystarczy upewnić się, że Siebel ma to zapisane
                fnLog("| Firma jest poprawnie przypisana. Aktualizuje BC...");
                bcContact.SetFieldValue("TMO Profile Id", sProfileId);
                bcContact.SetFieldValue("TMO Multiparty Company", sAccountContactIntegrationIdFromProfile);
                bcContact.WriteRecord();
            } else {
                // PATCH - Brakuje powiązania profilu z konkretną firmą
                fnLog("| PATCH PROFILE - Add Related Parties...");
                ctx.ps.psWpmPatchIn = ctx.app.NewPropertySet();
                ctx.ps.psWpmPatchOut = ctx.app.NewPropertySet();

                propertySetter(ctx.ps.psWpmPatchIn, [
                    { name: "Account Integration Id", value: accountIntId },
                    { name: "Entity Referred Type", value: "Customer" },
                    { name: "Role", value: "adminCompany" },
                    { name: "Profile Id", value: sProfileId },
                    { name: "Input Integration Object", value: "Req6ProfileManagementAPI:body" },
                    { name: "ProcessName", value: "TMO profileManagementAddRelParties MAPI" }
                ]);

                ctx.bs.workflowProcessManager.InvokeMethod("RunProcess", ctx.ps.psWpmPatchIn, ctx.ps.psWpmPatchOut);

                if (ctx.ps.psWpmPatchOut.GetProperty("Error Code") !== "") {
                    ctx.app.RaiseErrorText("Blad synchronizacji (PATCH). Brak mozliwosci przypisania firmy do istniejacego profilu.");
                } else {
                    sAccountContactIntegrationIdFromProfile = accountIntId;
                    bcContact.SetFieldValue("TMO Profile Id", sProfileId);
                    bcContact.SetFieldValue("TMO Multiparty Company", accountIntId);
                    bcContact.WriteRecord();
                }
            }
        } 
        // --- SCENARIUSZ B: PROFIL NIE ISTNIEJE (Tworzymy - POST) ---
        else {
            fnLog("| Profile not found! Odpalam POST /profiles (CREATE)...");
            
            ctx.ps.psWpmPostIn = ctx.app.NewPropertySet();
            ctx.ps.psWpmPostOut = ctx.app.NewPropertySet();

            var convertedLoginMethod = convertLICLangToHAL(ctx, loginMethod);

            propertySetter(ctx.ps.psWpmPostIn, [
                { name: "Input_ACCOUNT_INT_ID", value: accountIntId },
                { name: "Input_CONTACT_INT_ID", value: contactId },
                { name: "Input_CONTACT_LOGIN_SSO", value: ssoLogin },
                { name: "Input_CONTACT_OTP_MSISDN", value: otpMsisdn },
                { name: "Input_CONTACT_NAME", value: firstName },
                { name: "Input_CONTACT_LASTNAME", value: lastName },
                { name: "Input_CONTACT_LOGINMETHOD", value: convertedLoginMethod },
                { name: "ProcessName", value: "TMO profileManagementCreate MAPI" }
            ]);

            ctx.bs.workflowProcessManager.InvokeMethod("RunProcess", ctx.ps.psWpmPostIn, ctx.ps.psWpmPostOut);

            // Parsujemy wynik POST (Tutaj API odpowiada krótszą ścieżką - bez ListOfRes...)
            var postRespBody = getDeepChild(ctx.ps.psWpmPostOut, ["RestResponse", "RespBody"]);

            if (postRespBody !== null) {
                sProfileId = postRespBody.GetProperty("id");
                psRelatedParties = postRespBody.GetChild(0);

                if (psRelatedParties) {
                    for (var k = 0; k < psRelatedParties.GetChildCount(); k++) {
                        var createdParty = psRelatedParties.GetChild(k);
                        if (createdParty.GetProperty("entityReferredType") === "Customer" && createdParty.GetProperty("role") === "adminCompany") {
                            sAccountContactIntegrationIdFromProfile = createdParty.GetProperty("id");
                        }
                    }
                }

                if (sAccountContactIntegrationIdFromProfile === accountIntId) {
                    bcContact.SetFieldValue("TMO Profile Id", sProfileId);
                    bcContact.SetFieldValue("TMO Multiparty Company", sAccountContactIntegrationIdFromProfile);
                    bcContact.WriteRecord();
                } else {
                    ctx.app.RaiseErrorText("Niezgodnosc Account Integration Id zwroconego po procedurze POST.");
                }
            } else {
                 ctx.app.RaiseErrorText("Blad zewnetrznego API podczas tworzenia Profilu Cyfrowego. Pusta odpowiedz.");
            }
        }

        // Zwracamy wyliczone zmienne dla obiektu VBC
        result.profileId = sProfileId;
        result.multipartyCompany = sAccountContactIntegrationIdFromProfile;

    } catch (e) {
        var sErrorMsg = (e.errText) ? e.errText : e.toString();
        fnLog("ERROR in SyncOnePortalProfile: " + sErrorMsg);
        throw e;
    } finally {
        fnLog("--------------------------------------------------");
        fnLog("| SYNC ONE PORTAL PROFILE - STOP                 |");
        fnLog("--------------------------------------------------");
    }

    return result;
}
