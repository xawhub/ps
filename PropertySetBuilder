function WebApplet_PreInvokeMethod(MethodName) {
    
    // 1. OBSŁUGA FILTROWANIA ZDUPLIKOWANYCH PROFILI (Zanim wykona się zapytanie)
    if (MethodName === "ExecuteQuery" || MethodName === "Find") {
        var ctxQ = { app: TheApplication(), bo: {}, bc: {}, ps: {}, bs: {} };
        try {
            initBs(ctxQ, [{ name: "Workflow Process Manager", alias: "workflowProcessManager" }]);

            var searchSpecREST = getSearchSpec(ctxQ);
            
            if (searchSpecREST !== "") {
                var currentExpr = this.BusComp().GetSearchExpr() || "";
                var finalExpr = "";
                
                // Jeśli standardowy searchExpr jest pusty, wycinamy pierwsze ' AND '
                if (currentExpr === "") {
                    finalExpr = searchSpecREST.replace(/^\s*AND\s*/i, "");
                } else {
                    finalExpr = currentExpr + searchSpecREST;
                }
                
                this.BusComp().SetSearchExpr(finalExpr);
            }
        } catch (e) {
            TheApplication().Trace("Błąd przed ExecuteQuery: " + e.toString());
        } finally {
            cleanup(ctxQ);
        }
        
        // Zwracamy Continue, żeby Siebel sam naturalnie uruchomił query z naszym nowym filtrem!
        return (ContinueOperation);
    }

    // 2. OBSŁUGA WYBORU REKORDU I ZAPISU (Zastępuje standardową akcję)
    if (MethodName === "PickRecord") {
        var ctxP = { app: TheApplication(), bo: {}, bc: {}, ps: {}, bs: {} };
        try {
            initBoBc(ctxP, [{
                name: "Account", isActive: true,
                bcList: [{ name: "TMO Contact Managed BP VBC", alias: "BillingProfilesVbc" }]
            }]);
            initBs(ctxP, [{ name: "FINS Teller UI Navigation", alias: "finsTellerUiNavigation" }]);

            PickRecord(ctxP, this);
            
        } catch (e) {
            // Bezpieczne przechwycenie błędu z VBC i wyświetlenie okienka z ostrzeżeniem na UI
            TheApplication().RaiseErrorText(e.errText || e.toString());
        } finally {
            cleanup(ctxP);
        }
        
        return (CancelOperation); // Siebel nie musi już nic robić, sami zamknęliśmy aplet
    }

    return (ContinueOperation);
}

function Service_PreInvokeMethod(MethodName, Inputs, Outputs) {
    try {
        // Opcjonalny log, żebyś widział w logach serwera, co dokładnie uderza do Twojego VBC
        // fnLog("VBC Wywolanie Metody: " + MethodName, LOG_LOW_LVL);

        switch (MethodName) {
            case "Init":
                Init(Inputs, Outputs); // Inicjalizacja struktury VBC (definicje pól)
                return (CancelOperation);

            case "Query":
                Query(Inputs, Outputs);
                return (CancelOperation);

            case "Insert":
                Insert(Inputs, Outputs);
                return (CancelOperation);

            case "Delete":
                Delete(Inputs, Outputs);
                return (CancelOperation);

            // Jeśli profil bilingowy nie wspiera edycji, zostawiamy Update puste lub rzucamy błąd
            case "Update":
                // Update(Inputs, Outputs); 
                // return (CancelOperation);
                break;
        }

        // Jeśli wpadnie jakakolwiek inna, standardowa metoda Siebela, przepuszczamy ją dalej
        return (ContinueOperation);

    } catch (e) {
        // Jeśli jakikolwiek błąd "przecieknie" przez nasze funkcje (co nie powinno się zdarzyć),
        // łapiemy go tutaj, żeby zapobiec zawieszeniu aplikacji.
        TheApplication().Trace("CRITICAL ERROR in VBC PreInvokeMethod (" + MethodName + "): " + e.toString());
        throw (e);
    }
}
