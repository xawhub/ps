function getSearchSpec(ctx) {
    var profileId = "";
    var accountIntegrationId = "";
    var searchSpec = "";
    
    try {
        var activeBO = ctx.app.ActiveBusObject();
        if (activeBO !== null && activeBO.Name() === "Account") {
            var bcContact = activeBO.GetBusComp("Contact");
            profileId = bcContact.GetFieldValue("TMO Profile Id");
            accountIntegrationId = bcContact.GetFieldValue("TMO Multiparty Company"); // Spójne z nowym podejściem
        }

        // Jeśli brak profilu, po prostu zwracamy puste filtry
        if (!profileId || profileId === "" || !accountIntegrationId || accountIntegrationId === "") {
            return searchSpec;
        }

        ctx.ps.psWpmIn = ctx.app.NewPropertySet();
        ctx.ps.psWpmOut = ctx.app.NewPropertySet();

        propertySetter(ctx.ps.psWpmIn, [
            { name: "ProcessName", value: "TMO permissions MAPI" },
            { name: "Input_AccountIntegrationId", value: accountIntegrationId },
            { name: "Input_TMOSSOID", value: profileId },
            { name: "Input_Query", value: "contains(assetRoles,and(eq(manageableAsset.entityType,BillingAccount),eq(role.entityType,technicalRole)))" },
            { name: "Input_Fields", value: "assetRoles.manageableAsset.id" }
        ]);

        ctx.bs.workflowProcessManager.InvokeMethod("RunProcess", ctx.ps.psWpmIn, ctx.ps.psWpmOut);

        var listRespBody = getDeepChild(ctx.ps.psWpmOut, ["RespBody", "ListOfRespBody"]);
        if (listRespBody !== null) {
            for (var i = 0; i < listRespBody.GetChildCount(); i++) {
                // Bezpieczne pobieranie ID z zagnieżdżonej struktury MAPI
                var manageableAsset = getDeepChild(listRespBody, [i, "ListOfassetRoles", "assetRoles", "ListOfmanageableAsset", "manageableAsset"]);
                if (manageableAsset) {
                    var bpId = manageableAsset.GetProperty("id");
                    if (bpId !== "") {
                        searchSpec += " AND [Name] <> '" + bpId + "'";
                    }
                }
            }
        }
        
        return searchSpec;

    } catch (e) {
        TheApplication().Trace("Błąd w getSearchSpec na aplecie PopUp: " + e.toString());
        return ""; // W razie błędu API nie blokujemy okienka
    }
}

function PickRecord(ctx, applet) {
    ctx.ps.navIn = ctx.app.NewPropertySet();
    ctx.ps.navOut = ctx.app.NewPropertySet();

    applet.BusComp().ActivateField("Name");
    var billingProfileNumber = applet.BusComp().GetFieldValue("Name");

    try {
        // Bez zbędnej pętli - próbujemy wstawić rekord i delegujemy walidację do funkcji Insert w VBC
        ctx.bc.BillingProfilesVbc.NewRecord(NewAfter);
        ctx.bc.BillingProfilesVbc.SetFieldValue("Billing Profile Number", billingProfileNumber);
        
        // Zapis rekordu. W przypadku duplikatu, wywali błąd skonfigurowany w Insert
        ctx.bc.BillingProfilesVbc.WriteRecord();

    } catch (e) {
        // Wycofujemy zepsuty rekord, żeby VBC wróciło do normy
        ctx.bc.BillingProfilesVbc.UndoRecord();
        throw (e);
    }

    applet.InvokeMethod("CloseApplet");

    // Odświeżenie apletu docelowego (aby VBC pobrało nowe dane)
    ctx.ps.navIn.SetProperty("Refresh All", "Y");
    ctx.bs.finsTellerUiNavigation.InvokeMethod("RefreshCurrentApplet", ctx.ps.navIn, ctx.ps.navOut);
}

