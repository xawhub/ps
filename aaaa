skinparam TitleBorderRoundCorner 15

title UC1: Create or fetch Profile on demand

participant "VBC (Logika)" as VBC
participant "Osoba Kontaktowa\n(Contact BC)" as Contact
participant "Profile API" as ProfileAPI

opt [Profile Id and Multiparty Company Id are EMPTY]
    note over VBC: User triggers insert action on VBC
    
    VBC -> ProfileAPI: GET /profile (email=Contact.Email)
    ProfileAPI --> VBC: profile data or None
    
    alt [profile found]
        note over VBC: check if profile contains relatedParties\n(entityReferredType: Customer, role: adminCompany, id: nrKlienta)
        
        alt [relatedParties entity exists]
            note over VBC: save fetched Profile Id\nand Multiparty Company Id
            VBC -> Contact: update fields on Contact BC
            
        else [relatedParties entity missing]
            note over VBC: add missing relatedParties to profile
            VBC -> ProfileAPI: POST /profile/{profileId}/relatedParties\n(payload: [{entityReferredType: "Customer", role: "adminCompany", id: nrKlienta}])
            ProfileAPI --> VBC: 200 OK / 201 Created
            
            note over VBC: save fetched Profile Id\nand Multiparty Company Id
            VBC -> Contact: update fields on Contact BC
        end
        
    else [profile not found]
        note over VBC: Try to create profile on demand
        VBC -> ProfileAPI: POST /profile
        ProfileAPI --> VBC: profile data (201 Created)
        
        note over VBC: save new Profile Id\nand Multiparty Company Id
        VBC -> Contact: update fields on Contact BC
    end
end

center footer Copyright T-Mobile Polska S.A.
@enduml


