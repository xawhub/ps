## 4. Code Comparison: Main SQL Scripts (`.sql`)

### 4.1. BEFORE: Legacy `wp_update_pds_flag.sql`
```sql
/*
--*************************************************************************************
-- File: wp_update_pds_flag.sql
-- Desc: Populate PDS flag from AMS to Siebel
-- Created & Reviewed by : RadhaKrishna/Eric Navis
-- Date: 12/08/2022
-- User Story : US996052 (Script to set PDS flag in siebel and AMS)
-- Dubeyr503: Updated for US2035885
--*************************************************************************************
*/

SET SERVEROUTPUT ON
--DBMS_OUTPUT.PUT_LINE('Delete');

DECLARE
    counter NUMBER(9) := 0;
    CreatedBy VARCHAR2(15) := '&1';
    sAgreementId VARCHAR2(15);
    sPartyId VARCHAR2(15);
    sDate DATE := trunc(SYSDATE);
    sNewDate DATE := trunc(SYSDATE) - 1;

    --v_systimestamp TIMESTAMP := SYSTIMESTAMP;
    CURSOR curr_rec IS
      SELECT /*+ opt_param('hash_join_enabled','true') opt_param('optimizer_mode','all_rows') */
         ROWNUM                             AS ROW_ID
        ,'FOR_IMPORT'                       AS IF_ROW_STAT
        ,2901900 + FLOOR(ROWNUM / 5000)     AS IF_ROW_BATCH_NUM
        ,orgparty.PARTY_UID                 AS PARTY_UID
        ,orgparty.PARTY_TYPE_CD             AS PARTY_TYPE_CD
        ,org.NAME                           AS NAME
        ,org.LOC                            AS LOC
        ,orgbu.ROW_ID                       AS ACCNT_BI
        ,orgbu.NAME                         AS ACCNT_BU
        ,org.X_WP_PRI_PDS_FLG               AS X_WP_PRI_PDS_FLG
        ,org.ROW_ID                         AS PARTY_ID
      FROM
              SIEBEL.S_PARTY   orgparty
        INNER JOIN SIEBEL.S_ORG_EXT org   ON orgparty.ROW_ID = org.PAR_ROW_ID
        INNER JOIN SIEBEL.S_BU      orgbu ON org.BU_ID       = orgbu.ROW_ID
      WHERE
            org.OU_TYPE_CD = 'Customer'
        AND org.NAME in
        (SELECT NAME FROM SIEBEL.S_ORG_EXT WHERE ROW_ID IN (SELECT MASTER_OU_ID FROM SIEBEL.S_ORG_EXT WHERE NAME IN
          (SELECT PARTY_ID FROM PDS_MIGRATED_PARTY@EDS_AMS_DBLINK PMP WHERE CREATED_BY = CreatedBy)));

    reg_rec curr_rec%ROWTYPE;

BEGIN
    DELETE FROM siebel.EIM_ACCOUNT WHERE if_row_batch_num BETWEEN 2901900 AND 2901999;
    DELETE FROM siebel.EIM_ENTLMNT WHERE if_row_batch_num BETWEEN 2901900 AND 2901999;
    DELETE FROM siebel.EIM_DEFECT  WHERE if_row_batch_num BETWEEN 2901900 AND 2901999;
    COMMIT;

    FOR reg_rec IN curr_rec LOOP
      BEGIN
        sPartyId := reg_rec.PARTY_ID;
        SELECT AGREE_ID INTO sAgreementId FROM SIEBEL.CX_AGREE_ORG WHERE ACCNT_ID = sPartyId AND (END_DT IS NULL OR END_DT >= sDate);
        --DBMS_OUTPUT.PUT_LINE('AGREE_ID is '||sAgreementId);

        INSERT INTO SIEBEL.EIM_ACCOUNT
        (
          ROW_ID
         ,IF_ROW_STAT
         ,IF_ROW_BATCH_NUM
         ,PARTY_UID
         ,PARTY_TYPE_CD
         ,NAME
         ,LOC
         ,ACCNT_BI
         ,ACCNT_BU
         ,X_WP_PRI_PDS_FLG
        )
        VALUES
        (
          reg_rec.PARTY_ID,
          reg_rec.IF_ROW_STAT,
          reg_rec.IF_ROW_BATCH_NUM,
          reg_rec.PARTY_UID,
          reg_rec.PARTY_TYPE_CD,
          reg_rec.NAME,
          reg_rec.LOC,
          reg_rec.ACCNT_BI,
          reg_rec.ACCNT_BU,
          'Y'
        );

        INSERT INTO SIEBEL.EIM_ENTLMNT
        (
          IF_ROW_BATCH_NUM,
          IF_ROW_STAT,
          ROW_ID,
          ORG_ACCNT_BI,
          ORG_ACCNT_BU,
          ORG_ACCNT_LOC,
          ORG_ACCNT_NAME,
          PAR_AGREE_ACC_BI,
          PAR_AGREE_ACC_BU,
          PAR_AGREE_ACC_LOC,
          PAR_AGREE_ACC_NAME,
          PAR_AGREE_BI,
          PAR_AGREE_BU,
          PAR_AGREE_NAME,
          PAR_AGREE_REV_NUM,
          ENTL_NAME,
          ORG_EFF_END_DT
        )
        (SELECT
          reg_rec.IF_ROW_BATCH_NUM,
          reg_rec.IF_ROW_STAT,
          ENT_ORG.ROW_ID,
          '0-R9NH',
          'Default Organization',
          PARTY.LOC,
          PARTY.NAME,
          '0-R9NH',
          'Default Organization',
          reg_rec.LOC,
          reg_rec.NAME,
          '0-R9NH',
          'Default Organization',
          AGREEMENT.NAME,
          AGREEMENT.REV_NUM,
          ENT.NAME,
          case
            when (ENT_ORG.EFF_START_DT >= sDate) then ENT_ORG.EFF_START_DT
            when (ENT_ORG.EFF_START_DT < sDate)  then sNewDate
          End
        FROM
          SIEBEL.S_DOC_AGREE AGREEMENT,
          SIEBEL.S_ENTLMNT_ORG ENT_ORG,
          SIEBEL.S_ENTLMNT ENT,
          SIEBEL.S_ORG_EXT PARTY
          --SIEBEL.S_ORG_EXT_XM TRADING
        WHERE
              AGREEMENT.ROW_ID = ENT.PAR_AGREE_ID
          AND ENT.ROW_ID = ENT_ORG.AGREE_ID
          AND ENT_ORG.OU_ID = PARTY.ROW_ID
          --AND PARTY.ROW_ID = TRADING.PAR_ROW_ID(+)
          --AND (TRADING.ATTRIB_13 is null OR TRADING.ATTRIB_13>=sDate)
          --AND (TRADING.X_WP_ROLE_STATUS_TYPE(+) = 'TRA' AND TRADING.type (+) = 'ROLE_ROLE_STATUS')
          AND (AGREEMENT.EFF_END_DT IS NULL OR AGREEMENT.EFF_END_DT >= sDate)
          AND (ENT_ORG.EFF_END_DT IS NULL OR ENT_ORG.EFF_END_DT >= sDate)
          AND ENT.ENTL_TYPE_CD = 'PRICING'
          AND AGREEMENT.ROW_ID = sAgreementId);

        INSERT INTO SIEBEL.EIM_DEFECT
        (
          IF_ROW_BATCH_NUM,
          IF_ROW_STAT,
          ROW_ID,
          DEFECT_NUM
        )
        (SELECT
          reg_rec.IF_ROW_BATCH_NUM,
          'IMPORTED',
          ROW_ID,
          NAME
        FROM SIEBEL.S_ORG_EXT WHERE MASTER_OU_ID = sPartyId);

        counter := counter + 1;
        IF counter = 5000 THEN
            COMMIT;
            counter := 0;
        END IF;

      EXCEPTION
        WHEN OTHERS THEN
            UPDATE PDS_MIGRATED_PARTY@EDS_AMS_DBLINK
            SET SDM_MIGRATED_STATUS = 'FAILURE', SDM_ERROR_MSG = 'SQL_PROCESSING_ERROR', LAST_UPD = SYSTIMESTAMP
            WHERE PARTY_ID IN (SELECT NAME FROM SIEBEL.S_ORG_EXT WHERE MASTER_OU_ID = sPartyId);
            CONTINUE;
      END;
    END LOOP;
    COMMIT;

    UPDATE PDS_MIGRATED_PARTY@EDS_AMS_DBLINK
    SET SDM_MIGRATED_STATUS = 'FAILURE', SDM_ERROR_MSG = 'PO NUMBER DOES NOT EXIST IN SIEBEL', LAST_UPD = SYSTIMESTAMP
    WHERE PARTY_ID NOT IN
    (SELECT PARTY_ID FROM PDS_MIGRATED_PARTY@EDS_AMS_DBLINK A, SIEBEL.S_ORG_EXT B WHERE A.PARTY_ID = B.NAME)
    AND CREATED_BY = CreatedBy;
END;
/
EXIT;
```

### 4.2. AFTER (Package 1): `wp_kn221_update_pds_flag.sql` (PDS Flag Hierarchy Only + Role Refresh)
* **What Changed:**
  1. Removed `CX_AGREE_ORG` and `EIM_ENTLMNT` completely so PDS Flag updates never fail when an agreement is missing.
  2. Selects both the Group Merchant (`ROW_ID`) and all child POs in its hierarchy (`MASTER_OU_ID` / `PAR_OU_ID`), so every PO in the Group Merchant's hierarchy gets `X_WP_PRI_PDS_FLG = 'Y'` in `EIM_ACCOUNT` and gets staged in `EIM_DEFECT` for Role Refresh.
  3. Filters `NVL(org.X_WP_PRI_PDS_FLG, 'N') <> 'Y'` so merchants already set to `'Y'` are left unchanged and are **not** re-refreshed.

```sql
SET SERVEROUTPUT ON
SET VERIFY OFF
WHENEVER SQLERROR EXIT FAILURE

DECLARE
    counter   NUMBER(9) := 0;
    CreatedBy VARCHAR2(15) := '&1';

    -- Selects Group Merchants and all child POs in their hierarchy (via MASTER_OU_ID / PAR_OU_ID)
    -- Excludes records where X_WP_PRI_PDS_FLG is already 'Y'
    CURSOR curr_rec IS
      SELECT /*+ opt_param('hash_join_enabled','true') opt_param('optimizer_mode','all_rows') */
         ROWNUM                             AS ROW_ID
        ,'FOR_IMPORT'                       AS IF_ROW_STAT
        ,2901900 + FLOOR(ROWNUM / 5000)     AS IF_ROW_BATCH_NUM
        ,orgparty.PARTY_UID                 AS PARTY_UID
        ,orgparty.PARTY_TYPE_CD             AS PARTY_TYPE_CD
        ,org.NAME                           AS NAME
        ,org.LOC                            AS LOC
        ,orgbu.ROW_ID                       AS ACCNT_BI
        ,orgbu.NAME                         AS ACCNT_BU
        ,org.X_WP_PRI_PDS_FLG               AS X_WP_PRI_PDS_FLG
        ,org.ROW_ID                         AS PARTY_ID
      FROM
              SIEBEL.S_PARTY   orgparty
        INNER JOIN SIEBEL.S_ORG_EXT org   ON orgparty.ROW_ID = org.PAR_ROW_ID
        INNER JOIN SIEBEL.S_BU      orgbu ON org.BU_ID       = orgbu.ROW_ID
      WHERE
            org.OU_TYPE_CD = 'Customer'
        AND NVL(org.X_WP_PRI_PDS_FLG, 'N') <> 'Y'
        AND (
            org.ROW_ID IN (
                SELECT MASTER_OU_ID FROM SIEBEL.S_ORG_EXT WHERE NAME IN (
                    SELECT PARTY_ID FROM PDS_MIGRATED_PARTY@EDS_AMS_DBLINK PMP WHERE CREATED_BY = CreatedBy
                )
                UNION
                SELECT ROW_ID FROM SIEBEL.S_ORG_EXT WHERE NAME IN (
                    SELECT PARTY_ID FROM PDS_MIGRATED_PARTY@EDS_AMS_DBLINK PMP WHERE CREATED_BY = CreatedBy
                )
            )
            OR org.MASTER_OU_ID IN (
                SELECT MASTER_OU_ID FROM SIEBEL.S_ORG_EXT WHERE NAME IN (
                    SELECT PARTY_ID FROM PDS_MIGRATED_PARTY@EDS_AMS_DBLINK PMP WHERE CREATED_BY = CreatedBy
                )
                UNION
                SELECT ROW_ID FROM SIEBEL.S_ORG_EXT WHERE NAME IN (
                    SELECT PARTY_ID FROM PDS_MIGRATED_PARTY@EDS_AMS_DBLINK PMP WHERE CREATED_BY = CreatedBy
                )
            )
            OR org.ROW_ID IN (
                SELECT ROW_ID FROM SIEBEL.S_ORG_EXT
                START WITH NAME IN (
                    SELECT PARTY_ID FROM PDS_MIGRATED_PARTY@EDS_AMS_DBLINK PMP WHERE CREATED_BY = CreatedBy
                )
                CONNECT BY NOCYCLE PRIOR ROW_ID = PAR_OU_ID
            )
        );

    reg_rec curr_rec%ROWTYPE;

BEGIN
    DELETE FROM siebel.EIM_ACCOUNT WHERE if_row_batch_num BETWEEN 2901900 AND 2901999;
    DELETE FROM siebel.EIM_DEFECT  WHERE if_row_batch_num BETWEEN 2901900 AND 2901999;
    COMMIT;

    FOR reg_rec IN curr_rec LOOP
      BEGIN
        -- 1. Stage PDS Flag = 'Y' in EIM_ACCOUNT for Group Merchant / Child PO
        INSERT INTO SIEBEL.EIM_ACCOUNT (
            ROW_ID, IF_ROW_STAT, IF_ROW_BATCH_NUM, PARTY_UID, PARTY_TYPE_CD,
            NAME, LOC, ACCNT_BI, ACCNT_BU, X_WP_PRI_PDS_FLG
        ) VALUES (
            reg_rec.PARTY_ID, reg_rec.IF_ROW_STAT, reg_rec.IF_ROW_BATCH_NUM, reg_rec.PARTY_UID, reg_rec.PARTY_TYPE_CD,
            reg_rec.NAME, reg_rec.LOC, reg_rec.ACCNT_BI, reg_rec.ACCNT_BU, 'Y'
        );

        -- 2. Stage updated Party in EIM_DEFECT for Role Refresh (wp_update_tra_status.sh)
        INSERT INTO SIEBEL.EIM_DEFECT (
            IF_ROW_BATCH_NUM, IF_ROW_STAT, ROW_ID, DEFECT_NUM
        ) VALUES (
            reg_rec.IF_ROW_BATCH_NUM, 'IMPORTED', reg_rec.PARTY_ID, reg_rec.NAME
        );

        counter := counter + 1;
        IF counter = 5000 THEN
            COMMIT;
            counter := 0;
        END IF;

      EXCEPTION
        WHEN OTHERS THEN
            UPDATE PDS_MIGRATED_PARTY@EDS_AMS_DBLINK
            SET SDM_MIGRATED_STATUS = 'FAILURE', SDM_ERROR_MSG = 'SQL_PROCESSING_ERROR', LAST_UPD = SYSTIMESTAMP
            WHERE PARTY_ID = reg_rec.NAME AND CREATED_BY = CreatedBy;
            CONTINUE;
      END;
    END LOOP;
    COMMIT;

    UPDATE PDS_MIGRATED_PARTY@EDS_AMS_DBLINK
    SET SDM_MIGRATED_STATUS = 'FAILURE', SDM_ERROR_MSG = 'PO NUMBER DOES NOT EXIST IN SIEBEL', LAST_UPD = SYSTIMESTAMP
    WHERE PARTY_ID NOT IN (
        SELECT PARTY_ID FROM PDS_MIGRATED_PARTY@EDS_AMS_DBLINK A, SIEBEL.S_ORG_EXT B WHERE A.PARTY_ID = B.NAME
    ) AND CREATED_BY = CreatedBy;
    COMMIT;
END;
/
EXIT;
```

### 4.3. AFTER (Package 2): `wp_kn221_expire_entitlement.sql` (Entitlement Expiration Only + Role Refresh)
* **What Changed:**
  1. Removed `EIM_ACCOUNT` insert, keeping only the `EIM_ENTLMNT` expiration (`sNewDate := trunc(SYSDATE) - 1`, evaluated once at run start) and `EIM_DEFECT` Role Refresh.
  2. Wrapped the `CX_AGREE_ORG` lookup in its own `BEGIN ... EXCEPTION WHEN NO_DATA_FOUND` block so merchants without an active agreement are cleanly skipped without aborting the loop.
  3. Stages `EIM_DEFECT` for Role Refresh only when `SQL%ROWCOUNT > 0` (i.e. when an active Pricing Entitlement was actually found and expired).

```sql
SET SERVEROUTPUT ON
SET VERIFY OFF
WHENEVER SQLERROR EXIT FAILURE

DECLARE
    counter      NUMBER(9) := 0;
    CreatedBy    VARCHAR2(15) := '&1';
    sAgreementId VARCHAR2(15);
    sPartyId     VARCHAR2(15);
    sDate        DATE := trunc(SYSDATE);
    sNewDate     DATE := trunc(SYSDATE) - 1;
    v_rows_ins   NUMBER := 0;

    CURSOR curr_rec IS
      SELECT /*+ opt_param('hash_join_enabled','true') opt_param('optimizer_mode','all_rows') */
         ROWNUM                             AS ROW_ID
        ,'FOR_IMPORT'                       AS IF_ROW_STAT
        ,2902000 + FLOOR(ROWNUM / 5000)     AS IF_ROW_BATCH_NUM
        ,orgparty.PARTY_UID                 AS PARTY_UID
        ,orgparty.PARTY_TYPE_CD             AS PARTY_TYPE_CD
        ,org.NAME                           AS NAME
        ,org.LOC                            AS LOC
        ,orgbu.ROW_ID                       AS ACCNT_BI
        ,orgbu.NAME                         AS ACCNT_BU
        ,org.ROW_ID                         AS PARTY_ID
      FROM
              SIEBEL.S_PARTY   orgparty
        INNER JOIN SIEBEL.S_ORG_EXT org   ON orgparty.ROW_ID = org.PAR_ROW_ID
        INNER JOIN SIEBEL.S_BU      orgbu ON org.BU_ID       = orgbu.ROW_ID
      WHERE
            org.OU_TYPE_CD = 'Customer'
        AND org.NAME IN (
            SELECT PARTY_ID FROM PDS_MIGRATED_PARTY@EDS_AMS_DBLINK PMP WHERE CREATED_BY = CreatedBy
        );

    reg_rec curr_rec%ROWTYPE;

BEGIN
    DELETE FROM siebel.EIM_ENTLMNT WHERE if_row_batch_num BETWEEN 2902000 AND 2902999;
    DELETE FROM siebel.EIM_DEFECT  WHERE if_row_batch_num BETWEEN 2902000 AND 2902999;
    COMMIT;

    FOR reg_rec IN curr_rec LOOP
      BEGIN
        sPartyId := reg_rec.PARTY_ID;
        sAgreementId := NULL;
        v_rows_ins := 0;

        -- Safe lookup: if no active agreement exists in CX_AGREE_ORG, skip cleanly
        BEGIN
            SELECT AGREE_ID INTO sAgreementId
            FROM SIEBEL.CX_AGREE_ORG
            WHERE ACCNT_ID = sPartyId
              AND (END_DT IS NULL OR END_DT >= sDate)
              AND ROWNUM = 1;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                sAgreementId := NULL;
        END;

        IF sAgreementId IS NOT NULL THEN
            INSERT INTO SIEBEL.EIM_ENTLMNT (
                IF_ROW_BATCH_NUM, IF_ROW_STAT, ROW_ID,
                ORG_ACCNT_BI, ORG_ACCNT_BU, ORG_ACCNT_LOC, ORG_ACCNT_NAME,
                PAR_AGREE_ACC_BI, PAR_AGREE_ACC_BU, PAR_AGREE_ACC_LOC, PAR_AGREE_ACC_NAME,
                PAR_AGREE_BI, PAR_AGREE_BU, PAR_AGREE_NAME, PAR_AGREE_REV_NUM,
                ENTL_NAME, ORG_EFF_END_DT
            )
            (SELECT
                reg_rec.IF_ROW_BATCH_NUM, reg_rec.IF_ROW_STAT, ENT_ORG.ROW_ID,
                '0-R9NH', 'Default Organization', PARTY.LOC, PARTY.NAME,
                '0-R9NH', 'Default Organization', reg_rec.LOC, reg_rec.NAME,
                '0-R9NH', 'Default Organization', AGREEMENT.NAME, AGREEMENT.REV_NUM,
                ENT.NAME,
                CASE
                    WHEN (ENT_ORG.EFF_START_DT >= sDate) THEN ENT_ORG.EFF_START_DT
                    WHEN (ENT_ORG.EFF_START_DT < sDate)  THEN sNewDate
                END
            FROM
                SIEBEL.S_DOC_AGREE AGREEMENT,
                SIEBEL.S_ENTLMNT_ORG ENT_ORG,
                SIEBEL.S_ENTLMNT ENT,
                SIEBEL.S_ORG_EXT PARTY
            WHERE
                  AGREEMENT.ROW_ID = ENT.PAR_AGREE_ID
              AND ENT.ROW_ID = ENT_ORG.AGREE_ID
              AND ENT_ORG.OU_ID = PARTY.ROW_ID
              AND (AGREEMENT.EFF_END_DT IS NULL OR AGREEMENT.EFF_END_DT >= sDate)
              AND (ENT_ORG.EFF_END_DT IS NULL OR ENT_ORG.EFF_END_DT >= sDate)
              AND ENT.ENTL_TYPE_CD = 'PRICING'
              AND AGREEMENT.ROW_ID = sAgreementId);

            v_rows_ins := SQL%ROWCOUNT;

            -- Stage in EIM_DEFECT for Role Refresh only if an active Pricing Entitlement was expired
            IF v_rows_ins > 0 THEN
                INSERT INTO SIEBEL.EIM_DEFECT (
                    IF_ROW_BATCH_NUM, IF_ROW_STAT, ROW_ID, DEFECT_NUM
                ) VALUES (
                    reg_rec.IF_ROW_BATCH_NUM, 'IMPORTED', reg_rec.PARTY_ID, reg_rec.NAME
                );
            END IF;
        END IF;

        counter := counter + 1;
        IF counter = 5000 THEN
            COMMIT;
            counter := 0;
        END IF;

      EXCEPTION
        WHEN OTHERS THEN
            UPDATE PDS_MIGRATED_PARTY@EDS_AMS_DBLINK
            SET SDM_MIGRATED_STATUS = 'FAILURE', SDM_ERROR_MSG = 'SQL_PROCESSING_ERROR', LAST_UPD = SYSTIMESTAMP
            WHERE PARTY_ID = reg_rec.NAME AND CREATED_BY = CreatedBy;
            CONTINUE;
      END;
    END LOOP;
    COMMIT;

    UPDATE PDS_MIGRATED_PARTY@EDS_AMS_DBLINK
    SET SDM_MIGRATED_STATUS = 'FAILURE', SDM_ERROR_MSG = 'PO NUMBER DOES NOT EXIST IN SIEBEL', LAST_UPD = SYSTIMESTAMP
    WHERE PARTY_ID NOT IN (
        SELECT PARTY_ID FROM PDS_MIGRATED_PARTY@EDS_AMS_DBLINK A, SIEBEL.S_ORG_EXT B WHERE A.PARTY_ID = B.NAME
    ) AND CREATED_BY = CreatedBy;
    COMMIT;
END;
/
EXIT;
