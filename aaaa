skinparam TitleBorderRoundCorner 15

title UC3: Delete role(s) & disconnect Profile from Company

actor "user" as User
participant "Applet VBC" as Applet
participant "VBC (Logika)" as VBC
participant "Osoba Kontaktowa\n(Contact BC)" as Contact
participant "RNP (DPS API)" as RNP
participant "Profile API" as ProfileAPI

User -> Applet: trigger delete action
Applet -> VBC: Action triggered (Single or Bulk)

alt [Single Delete]
    VBC -> RNP: PATCH /permissions (status=inactive)
    RNP --> VBC: 200 OK
    
else [Bulk Delete: "Usuń wszystkie" / "Usuń komplet"]
    note over VBC: identify all active roles for the current applet
    loop [for each active role in applet]
        VBC -> RNP: PATCH /permissions (status=inactive)
        RNP --> VBC: 200 OK
    end
end

opt [Deleted role(s) were the LAST active on THIS applet]
    note over VBC: check if any active roles exist on OTHER applets for THIS company
    VBC -> RNP: GET /permissions\n(query: profileId AND multipartyCompanyId AND status=active)
    RNP --> VBC: list of active permissions for THIS company
    
    opt [List is EMPTY (No active permissions left for THIS company)]
        note over VBC: disconnect profile from THIS company ONLY
        VBC -> ProfileAPI: DELETE /profile/{profileId}/relatedParties\n(target: entityReferredType=Customer, role=adminCompany, id=multipartyCompanyId)
        ProfileAPI --> VBC: 200 OK / 204 No Content
        
        note over VBC: clear MultiParty data for this specific Contact in Siebel
        VBC -> Contact: clear [TMO MultiPartyCompany] field
        Contact --> VBC: Field cleared
    end
end

note over Applet: refresh view

